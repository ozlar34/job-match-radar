      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE listings SET quarantine_reason = $2, quarantined_at = NOW() WHERE id = ANY(string_to_array($1, ',')::int[]) AND quarantine_reason IS NULL RETURNING id;",
        "options": {
          "queryReplacement": "={{ $json.body.ids }},{{ $json.body.reason }}"
        }
      },
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Supabase - job-match-radar"
        }
      }
    }
