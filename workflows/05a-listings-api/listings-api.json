  "nodes": [
    {
      "id": "wh-get-unscored",
      "name": "Webhook: GET listings/unscored",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "listings/unscored",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": ""
    },
    {
      "id": "pg-select-unscored",
      "name": "Postgres: Select Unscored",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH quarantined AS (\n  UPDATE listings\n  SET quarantine_reason = 'no_body', quarantined_at = NOW()\n  WHERE scored_at IS NULL\n    AND quarantine_reason IS NULL\n    AND date_seen >= CURRENT_DATE - INTERVAL '8 days'\n    AND (description IS NULL OR LENGTH(TRIM(description)) < 200)\n  RETURNING id\n)\nSELECT id, source, title, company, location, description\nFROM listings\nWHERE scored_at IS NULL\n  AND quarantine_reason IS NULL\n  AND date_seen >= CURRENT_DATE - INTERVAL '8 days'\n  AND id NOT IN (SELECT id FROM quarantined);",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Supabase - job-match-radar"
        }
      }
    },
    {
      "id": "filter-phantom",
      "name": "Filter: Drop Phantom Rows",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-id",
              "leftValue": "={{ $json.id }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "respond-unscored",
