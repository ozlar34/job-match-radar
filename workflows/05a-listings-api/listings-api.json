        "options": {}
      }
    },
    {
      "id": "wh-post-score",
      "name": "Webhook: POST listings/score",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        224
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "listings/score",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": ""
    },
    {
      "id": "pg-update-score",
      "name": "Postgres: UPDATE Score",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        224,
        224
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH target AS (\n  SELECT id, md5(lower(trim(title)) || '|' || lower(trim(company))) AS real_echo\n  FROM listings WHERE id = $3\n),\nupd AS (\n  UPDATE listings SET score = $1, rationale = $2, cap_reason = NULLIF($5, ''), scored_at = NOW()\n  WHERE id = $3\n    AND ($4 IS NULL OR $4 = ''\n         OR md5(lower(trim(title)) || '|' || lower(trim(company))) = $4)\n  RETURNING id, score\n)\nSELECT t.id,\n       (SELECT score FROM upd) AS score,\n       CASE WHEN (SELECT id FROM upd) IS NOT NULL THEN 'ok'\n            WHEN ($4 IS NOT NULL AND $4 <> '' AND t.real_echo <> $4) THEN 'echo_mismatch'\n            ELSE 'no_row' END AS status\nFROM target t;",
        "options": {
          "queryReplacement": "={{ $json.body.score }},{{ $json.body.rationale }},{{ $json.body.id }},{{ $json.body.title_echo }},{{ $json.body.cap_reason }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Supabase - job-match-radar"
        }
      }
    },
    {
      "id": "wh-get-echo",
      "name": "Webhook: GET listings/echo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        448
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "listings/echo",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": ""
    },
    {
      "id": "pg-select-echo",
      "name": "Postgres: Select Echo",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        224,
        448
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, md5(lower(trim(title)) || '|' || lower(trim(company))) AS real_echo, score, scored_at FROM listings WHERE id = ANY(string_to_array($1, ',')::int[]);",
        "options": {
          "queryReplacement": "={{ $json.query.ids }}"
        }
      },
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Supabase - job-match-radar"
        }
      }
    },
    {
